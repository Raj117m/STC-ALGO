# Copy this file to .env and fill in your own keys. Never commit .env.

# Main app (app.py) uses Groq. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional, only used by the 8-step pipeline in pipeline_v5/ as fallbacks
GEMINI_API_KEY=
OPENAI_API_KEY=

# pipeline_v5: which backend to try first (gemini, groq, openai)
STC_ACTIVE_BACKEND=groq
